[Unit]
Description=Guzi Scholar invitation-only account service
After=network-online.target local-fs.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=guzi-account
Group=guzi-account
UMask=0077
WorkingDirectory=/opt/guzi-scholar/current/account
EnvironmentFile=/etc/guzi-scholar/account.env
ExecStartPre=/usr/bin/python3 -I -B /opt/guzi-scholar/current/account/user_service.py email-preflight
ExecStartPre=/usr/local/sbin/guzi-scholar-db-verify /var/lib/guzi-scholar/account/users.db
ExecStart=/usr/bin/python3 -I -B /opt/guzi-scholar/current/account/user_service.py serve --db /var/lib/guzi-scholar/account/users.db --host 127.0.0.1 --port 8478
Restart=on-failure
RestartSec=3s
TimeoutStartSec=30s
TimeoutStopSec=20s
StateDirectory=guzi-scholar/account
StateDirectoryMode=0700
RuntimeDirectory=guzi-scholar-account
RuntimeDirectoryMode=0700
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/guzi-scholar/account
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SocketBindDeny=any
SocketBindAllow=tcp:8478
TasksMax=64
MemoryMax=384M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
