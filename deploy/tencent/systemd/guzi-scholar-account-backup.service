[Unit]
Description=Create and verify a consistent Guzi Scholar account database backup
After=local-fs.target
ConditionPathExists=/var/lib/guzi-scholar/account/users.db

[Service]
Type=oneshot
User=guzi-account
Group=guzi-account
UMask=0077
RuntimeDirectory=guzi-scholar-account-backup
RuntimeDirectoryMode=0700
ExecStart=/usr/local/sbin/guzi-scholar-account-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/guzi-scholar/account /var/lib/guzi-scholar/account
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
