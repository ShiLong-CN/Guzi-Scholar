[Unit]
Description=Guzi Scholar read-only showcase
After=network-online.target local-fs.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
Group=ubuntu
UMask=0077
WorkingDirectory=/home/ubuntu/my-scholar-web/app
Environment=MY_SCHOLAR_READONLY=1
Environment=MY_SCHOLAR_DATA_DIR=/home/ubuntu/my-scholar-web/data
Environment=MY_SCHOLAR_LANDING_FILE=/home/ubuntu/my-scholar-web/app/landing.html
ExecStart=/usr/bin/python3 -B /home/ubuntu/my-scholar-web/app/server.py --host 127.0.0.1 --port 8081
Restart=on-failure
RestartSec=3s
TimeoutStartSec=45s
TimeoutStopSec=20s
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/my-scholar-web/data
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SocketBindDeny=any
SocketBindAllow=tcp:8081
TasksMax=128
MemoryMax=768M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
