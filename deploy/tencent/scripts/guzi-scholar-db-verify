#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: guzi-scholar-db-verify /absolute/path/to/users.db" >&2
  exit 64
fi

DB_PATH=$1
if [[ "$DB_PATH" != /* || ! -f "$DB_PATH" ]]; then
  echo "[verify-db] database must be an existing absolute path: $DB_PATH" >&2
  exit 66
fi

DB_REAL=$(python3 - "$DB_PATH" <<'PY'
import pathlib
import sys

print(pathlib.Path(sys.argv[1]).resolve(strict=True))
PY
)
python3 - "$DB_REAL" <<'PY'
import pathlib
import sqlite3
import sys

path = pathlib.Path(sys.argv[1])
connection = sqlite3.connect(str(path))
try:
    connection.execute("PRAGMA query_only = ON")
    quick_check = connection.execute("PRAGMA quick_check").fetchone()[0]
    if quick_check != "ok":
        raise SystemExit(f"quick_check failed: {quick_check}")
    tables = {
        row[0]
        for row in connection.execute(
            "SELECT name FROM sqlite_master WHERE type = 'table'"
        )
    }
    required_tables = {
        "users",
        "sessions",
        "invites",
        "schema_migrations",
        "ai_usage_daily",
        "email_challenges",
        "mail_outbox",
    }
    missing = required_tables - tables
    if missing:
        raise SystemExit("missing required tables: " + ", ".join(sorted(missing)))
    versions = {int(row[0]) for row in connection.execute("SELECT version FROM schema_migrations")}
    if versions != {1, 2, 3, 4, 5, 6}:
        raise SystemExit(f"unexpected schema migration versions: {sorted(versions)}")
    users_columns = {row[1] for row in connection.execute("PRAGMA table_info(users)")}
    missing_users_columns = {
        "recovery_code_hash",
        "terms_version",
        "privacy_version",
        "agreements_accepted_at",
        "invite_id",
        "email",
        "email_verified_at",
    } - users_columns
    if missing_users_columns:
        raise SystemExit("missing users columns: " + ", ".join(sorted(missing_users_columns)))
    ai_columns = {row[1] for row in connection.execute("PRAGMA table_info(ai_usage_daily)")}
    missing_ai_columns = {"request_count", "input_units"} - ai_columns
    if missing_ai_columns:
        raise SystemExit("missing AI usage columns: " + ", ".join(sorted(missing_ai_columns)))
    foreign_key_errors = list(connection.execute("PRAGMA foreign_key_check"))
    if foreign_key_errors:
        raise SystemExit(f"foreign_key_check failed: {foreign_key_errors[:3]}")
    user_count = connection.execute("SELECT COUNT(*) FROM users").fetchone()[0]
    session_count = connection.execute("SELECT COUNT(*) FROM sessions").fetchone()[0]
finally:
    connection.close()

print(f"[verify-db] ok path={path} users={user_count} sessions={session_count}")
PY
