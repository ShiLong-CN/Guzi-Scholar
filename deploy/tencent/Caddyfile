{
	email guzilab@163.com
	default_sni 82.156.152.27
	admin 127.0.0.1:2019
	grace_period 10s
	servers {
		protocols h1 h2 h3
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

82.156.152.27 {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			email guzilab@163.com
			profile shortlived
		}
	}

	encode zstd gzip

	header {
		-X-Powered-By
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	@account path /api/auth/*
	handle @account {
		reverse_proxy 127.0.0.1:8478 {
			header_up X-Forwarded-Proto https
		}
	}

	# The desktop account client probes /api/health on its configured base URL.
	handle /api/health {
		reverse_proxy 127.0.0.1:8478
	}

	handle /_health/showcase {
		rewrite * /api/health
		reverse_proxy 127.0.0.1:8081
	}

	# ai_gateway.py owns /health and the OpenAI-compatible paths after /ai is stripped.
	handle_path /ai/* {
		request_body {
			max_size 8MB
		}
		reverse_proxy 127.0.0.1:8480 {
			header_up X-Forwarded-Proto https
			flush_interval -1
		}
	}

	# Reserved for the filed-domain company site. It can remain empty during IP-only beta.
	handle_path /company/* {
		root * /srv/guzi-sites/company
		file_server
	}

	handle_path /updates/* {
		root * /opt/guzi-scholar/current/updates
		header Cache-Control "no-store"
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:8081
	}

	log {
		output stdout
		format json
	}
}
